{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "typecheck": "nuxi typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "npm --prefix api run dev",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/check-locales.mjs i18n/locales api/src/locales",
    "pokemon-names": "node scripts/generate-pokemon-names.mjs",
    "check:prod": "node scripts/check-production.mjs"
  },
  "dependencies": {
    "nuxt": "^4.6.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "postgres": "^4.0.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  }
}
