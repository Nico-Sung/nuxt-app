# Copier en .env (ignoré par git). Lu uniquement par `npm run dev`.
# Sans DATABASE_URL, l'API garde la liste en mémoire.
#
# Supabase : Connect → Transaction pooler, remplacer [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:6543/postgres
